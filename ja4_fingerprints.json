  "detection_rules": {
    "description": "Detection logic for Security Onion / Suricata / Arkime. JA4 inner hashes are preferred over full JA4 strings for environment-agnostic matching.",
    "ja4_based": [
      {
        "name": "SCAN-JA4-NMAP-PRIMARY",
        "match": "ja4_cipher_hash == '8f28d1f76561' AND cipher_count >= 70",
        "severity": "high",
        "notes": "nmap ssl-enum-ciphers primary probe (71 ciphers)"
      },
      {
        "name": "SCAN-JA4-NMAP-SSLV3",
        "match": "ja4 starts with 'ts3'",
        "severity": "high",
        "notes": "SSLv3 ClientHello \u2014 no legitimate modern client uses SSLv3"
      },
      {
        "name": "SCAN-JA4-NMAP-TLS10",
        "match": "ja4 starts with 't10'",
        "severity": "medium",
        "notes": "TLS 1.0 ClientHello \u2014 very rare in modern traffic, usually cipher enumeration"
      },
      {
        "name": "SCAN-JA4-NUCLEI-GO",
